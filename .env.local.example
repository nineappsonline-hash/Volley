# ── Supabase ──────────────────────────────────────────────
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Found under Project Settings → API.
# Required only for "Add member" (admin creates member accounts).
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ───────────────────────────────────────
# Optional. Get your API key at https://resend.com
# Without this, emails are silently skipped (no errors).
RESEND_API_KEY=
EMAIL_FROM=Volleyra <onboarding@resend.dev>
