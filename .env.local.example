# ── Supabase ──────────────────────────────────────────────
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Found under Project Settings → API.
# Required only for "Add member" (admin creates member accounts).
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ───────────────────────────────────────
# Optional. Get your API key at https://resend.com
# Without this, emails are silently skipped (no errors).
RESEND_API_KEY=
EMAIL_FROM=Volleyra <onboarding@resend.dev>

# ── Web Push (VAPID) ──────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys --json
# Public key is safe to commit (client + edge function secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key: NEVER commit. Set it on the notify-push function and here locally.
VAPID_PRIVATE_KEY=
# Contact the push service can reach you at (mailto: or https:).
VAPID_SUBJECT=mailto:contact@example.com

# ── AI Coach Assistant (optional) ─────────────────────────
# Provider: "openai" | "anthropic" | "openai-compatible".
# If unset or the key is missing, the AI Coach falls back to safe
# deterministic templates, so the module always works.
AI_PROVIDER=
AI_API_KEY=
# Override the endpoint (required for "openai-compatible").
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Estimated USD cost per 1K tokens (used for usage accounting only).
AI_PRICE_PER_1K_PROMPT=0.00015
AI_PRICE_PER_1K_COMPLETION=0.0006

# ── SEO ────────────────────────────────────────────────────
# Canonical production URL (no trailing slash). Defaults to https://playza.life.
NEXT_PUBLIC_SITE_URL=
# Optional search-engine ownership tokens (Search Console / Bing Webmaster).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Kashier — server-only credentials. Never use NEXT_PUBLIC_ for payment keys.
KASHIER_MODE=live
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_SITE_URL=https://playza.life
